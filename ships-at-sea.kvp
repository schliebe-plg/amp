App.DisplayName=Ships at Sea
App.RootDir=./ships-at-sea/
App.BaseDirectory=./ships-at-sea/
App.WorkingDir=./
App.StoresSupported=None
App.StoreSpecificSettings={}
App.StoreDownloadLocations={}
App.AppSettings={}
App.EnvironmentVariables={}
App.ExecutableWin=SasServer.exe
App.ExecutableLinux=
App.MonitorChildProcessName=SASServer-Win64-Shipping.exe
App.MonitorDirectChildOnly=False
App.DumpFullChildProcessTree=False
App.CommandLineArgs={{$PlatformArgs}} -log -Port={{$MainGamePort}} -QueryPort={{$SteamQueryPort}}
App.CommandLineParameterFormat=+{0} {1}
App.CommandLineParameterDelimiter= 
App.Ports=[{"Name":"Main Game Port","Ref":"MainGamePort","Direction":"Inbound","Protocol":"Both","Port":7777,"HostPort":7777,"PortRange":1},{"Name":"Steam Query Port","Ref":"SteamQueryPort","Direction":"Inbound","Protocol":"Both","Port":15000,"HostPort":15000,"PortRange":1}]
App.PrimaryApplicationPortRef=MainGamePort
App.AdminPortRef=MainGamePort
App.UniversalSleepApplicationUDPPortRef=MainGamePort
App.UniversalSleepSteamQueryPortRef=SteamQueryPort
App.SteamUpdateAnonymousLogin=true
App.UpdateSources=[{"StageName":"SteamCMD Download","SourceType":"SteamCMD","Platform":"Windows","AppID":3951240}]
App.PreStartStages=[]
App.CommandTriggers={}
App.UserActions=[]
App.ForceUpdate=False
App.AdminMethod=STDIO
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.UseSteamQueryForStatus=True
App.ApplicationReadyMode=RegexMatch
Console.AppReadyRegex=^.*Game engine initialized.*$
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
App.ExitMethod=OS_CLOSE
App.ExitTimeout=30
App.RestartDelaySeconds=0
App.RapidStartup=False
App.SupportsLiveSettingsChanges=False

